# Copy this file to .env and fill in real secret values. .env is read by
# homelab-deploy on every run and should be gitignored — this is the
# secrets half of the config; see .env.shared.example for the committed,
# non-secret half (shared tfvars, and the [backend] section for a remote
# Terraform backend).
#
# Two sections. [tfvars] is the default (no header needed for entries at
# the top of the file) — write the bare Terraform variable name and the
# app adds the TF_VAR_ prefix Terraform actually requires. [env] entries
# are set as literal environment variables (credentials, anything that
# isn't a Terraform input).
#
# Quoting values is optional, same as most .env-style tools: wrap a value
# in matching "..." or '...' if you want to (handy for values with
# leading/trailing spaces, or just out of habit from the old env.sh) and
# the quotes are stripped. Unquoted is equally fine. JSON-shaped values
# don't need quoting either way — they start with { or [, not a bare
# quote character, so quote-stripping never touches them.

authentik_token=
nomad_addr="http://192.168.2.6:4646"
nomad_ssl_verify=true
authentik_config={"issuer": "https://auth.example.lan"}

[env]
AWS_PROFILE=homelab

# Not a Terraform variable — how many directories `plan` runs
# concurrently (plan is read-only, so this is safe; apply always stays
# sequential in dependency order). Defaults to 6 if unset.
DEPLOY_PLAN_PARALLELISM=6
