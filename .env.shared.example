# Copy this file to .env.shared and commit it — unlike .env, this file
# is meant to go in version control. It's loaded FIRST (before .env), so
# a value in both files is a local override of the shared default; the
# same is true of [backend] settings, which merge key-by-key.
#
# Put non-secret config here: a bucket name or region isn't a secret,
# the credentials to access that bucket are (those stay in .env). Same
# format, same [tfvars]/[env] sections as .env — see .env.example for
# what those do. This file adds a third section, [backend]:

[backend]
# "type" selects the Terraform backend. Every other key becomes a
# `-backend-config` setting passed at `terraform init` time — this is
# deliberately generic (a type plus arbitrary key=value settings)
# rather than modeling any one backend's schema, since backend types
# don't agree on field names (s3/azurerm call the state-location
# setting "key", "local"/consul call it "path", gcs calls it "prefix").
#
# Whichever setting is the correct "location" field for your backend
# type MUST contain the literal placeholder {dir} — homelab-deploy
# substitutes it with each directory's own path (e.g. "services/a")
# before passing it to terraform, so every directory gets a unique,
# automatically-derived location instead of colliding on the same one.
# `homelab-deploy init --migrate-backend` refuses to run without it.
#
# This section is only consulted when you explicitly run
# `homelab-deploy init --migrate-backend` (per-directory, or for every
# not-yet-migrated directory at once) — it does nothing on its own, and
# nothing here ever runs without an explicit "yes" confirmation that
# shows the fully-resolved settings for every directory first.

type=s3
bucket=my-tfstate-bucket
region=us-east-1
key={dir}.tfstate
dynamodb_table=terraform-locks
